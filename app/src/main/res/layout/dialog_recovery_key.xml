<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="22dp"
    android:background="@drawable/dialog_bg_rounded">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/password_icon"
            android:tint="@color/accent"
            android:contentDescription="Recovery key" />

        <TextView
            android:id="@+id/dialogTitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save your recovery key"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:fontFamily="@font/poppins"
            android:textStyle="normal" />

    </LinearLayout>

    <TextView
        android:id="@+id/dialogSubtitleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Write this key down and keep it somewhere safe. You will need it if you move your vault to another device or reinstall Athena."
        android:textColor="@color/subtleText"
        android:textSize="14sp"
        android:fontFamily="@font/poppins"
        android:lineSpacingExtra="2dp" />

    <TextView
        android:id="@+id/recoveryKeyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:padding="16dp"
        android:gravity="center"
        android:text="ABCDE FGHIJ KLMNO PQRST UVWXY Z1234 56789"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.04"
        android:lineSpacingExtra="4dp"
        android:background="@drawable/recovery_key_box"
        android:textIsSelectable="false" />

    <TextView
        android:id="@+id/recoveryWarningText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="If you lose both this recovery key and your trusted device, your vault cannot be recovered."
        android:textColor="@color/subtleText"
        android:textSize="13sp"
        android:fontFamily="@font/poppins"
        android:lineSpacingExtra="2dp" />

    <TextView
        android:id="@+id/recoveryConfirmText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Make sure you have saved the key before continuing."
        android:textColor="@android:color/white"
        android:textSize="13sp"
        android:fontFamily="@font/poppins" />

    <LinearLayout
        android:id="@+id/buttonRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="horizontal"
        android:gravity="end">

        <TextView
            android:id="@+id/savedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="I SAVED IT"
            android:textAllCaps="true"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:fontFamily="@font/poppins"
            android:background="?attr/selectableItemBackgroundBorderless" />

    </LinearLayout>

</LinearLayout>