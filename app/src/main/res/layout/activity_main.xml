<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/vault_bg_gradient"
    android:padding="32dp">

    <ImageView
        android:id="@+id/logo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@mipmap/athena_logo"
        android:layout_marginBottom="28dp"
        android:contentDescription="Athena Logo" />

    <TextView
        android:id="@+id/appTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ATHENA"
        android:textColor="@android:color/white"
        android:textSize="28sp"
        android:fontFamily="@font/poppins"
        android:textStyle="normal"
        android:letterSpacing="0.11"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.athena.j.athena.SecureEditText
            android:id="@+id/masterPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_input_bg"
            android:hint="Enter Master Password"
            android:textSize="12sp"
            android:enabled="false"
            android:inputType="textPassword"
            android:padding="14dp"
            android:textColor="@android:color/white"
            android:textColorHint="#80FFFFFF"
            android:fontFamily="@font/poppins"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Unlock Vault"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/teal_200"
            android:padding="12dp"
            android:enabled="false"
            android:fontFamily="@font/poppins_semibold"
            android:elevation="4dp"
            android:layout_marginBottom="18dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#334B59"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/selectVaultButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"

                android:text="Select Vault File"
                android:textAllCaps="false"
                android:textColor="#A0FFFFFF"
                android:textSize="12sp"
                android:fontFamily="@font/poppins"

                android:gravity="center"
                android:padding="12dp"

                android:backgroundTint="@android:color/transparent"
                android:elevation="0dp"
                android:stateListAnimator="@null"

                app:icon="@drawable/folder_logo"
                app:iconTint="#A0FFFFFF"
                app:iconPadding="10dp"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/createVault"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"

                android:text="Create New Vault"
                android:textAllCaps="false"
                android:textColor="#A0FFFFFF"
                android:textSize="12sp"
                android:fontFamily="@font/poppins"

                android:gravity="center"
                android:padding="12dp"

                android:backgroundTint="@android:color/transparent"
                android:elevation="0dp"
                android:stateListAnimator="@null"

                app:icon="@drawable/plus_logo"
                app:iconTint="#A0FFFFFF"
                app:iconPadding="8dp"
                app:iconGravity="textStart" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>